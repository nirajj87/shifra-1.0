# Copy to .env.local (gitignored).
# Gemini key: https://aistudio.google.com/apikey
# Free tier (account ke hisaab se badalta hai): Flash-Lite ~15 requests/min, ~500-1500/day.
# Common Q&A, time, math, weather Open-Meteo se hote hain — Gemini tokens bachate hain.

VITE_GEMINI_API_KEY=
VITE_GEMINI_MODEL=gemini-2.5-flash-lite
VITE_GEMINI_ENABLED=true
VITE_MAX_OUTPUT_TOKENS=80
VITE_ANSWER_SENTENCES=2
VITE_WELCOME=true
VITE_LEARN_QA=true

# Local PC commands (only with npm run dev, localhost).
# Notepad, Docker, Explorer, and npm run work from these paths.
SHIFRA_PROJECTS_DIR=D:\Projects
SHIFRA_DOCKER_EXE=C:\Program Files\Docker\Docker\Docker Desktop.exe
